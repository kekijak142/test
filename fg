    local hndl = acc:FindFirstChild("Handle"); if not hndl then return end
    hndl.Anchored = false; hndl.CanCollide = false; hndl.Massless = true
    local hatAtt = hndl:FindFirstChildOfClass("Attachment"); local cPart = char:FindFirstChild("Head"); local cAtt = nil
