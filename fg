    acc.Parent = char; local w = Instance.new("Weld"); w.Name = "AccWeld"; w.Part0 = cPart; w.Part1 = hndl
    if cAtt and hatAtt then w.C0 = cAtt.CFrame; w.C1 = hatAtt.CFrame else if cPart.Name == "Head" then w.C0 = CFrame.new(0, cPart.Size.Y/2, 0); w.C1 = CFrame.new(0, -hndl.Size.Y/2, 0) end end
    w.Parent = hndl
end
